{
  "name": "@outpost/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sync API for Outpost: idempotent mutation ledger on top of SQLite.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
