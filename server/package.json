    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@outpost/shared": "*",
    "@types/node": "^24.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0"
  }
}
